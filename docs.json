{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "PlugKit",
  "description": "One API to publish, read, and reply across Instagram, WhatsApp & more — built for AI agents.",
  "colors": {
    "primary": "#FB4D17",
    "light": "#FB6B3D",
    "dark": "#FB4D17"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": ["index", "quickstart", "authentication"]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/connecting-accounts",
              "guides/connect-instagram",
              "guides/publishing",
              "guides/messaging",
              "guides/analytics",
              "guides/webhooks"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "openapi": "api-reference/openapi.json"
      }
    ]
  },
  "navbar": {
    "links": [
      { "label": "Dashboard", "href": "https://plugkit.co/dashboard" }
    ],
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "https://plugkit.co/dashboard"
    }
  },
  "footer": {
    "socials": {
      "website": "https://plugkit.co"
    }
  }
